{
  "name": "lassim-desktop",
  "productName": "LasSim",
  "version": "1.0.0",
  "description": "LasSim — Interactive 2D Geometric Optics Simulation Desktop App",
  "main": "main.js",
  "homepage": "https://denisvarga.eu/fyz",
  "author": {
    "name": "Denis Varga",
    "email": "mail@denisvarga.eu"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "LASSIM_DEV=1 electron .",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "sk.lassim.desktop",
    "productName": "LasSim",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "icon.svg",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "web",
        "filter": [
          "version.js",
          "version.json",
          "app.html",
          "index.html",
          "optics.js",
          "renderer.js",
          "i18n.js",
          "app.js",
          "styles.css",
          "landing.css",
          "landing.js"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "optp",
        "name": "LasSim Optical Project",
        "description": "LasSim 2D Optical Simulation Project",
        "mimeType": "application/json",
        "role": "Editor"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education;Science;Physics;",
      "icon": "icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "icon": "icon.png"
    }
  }
}

